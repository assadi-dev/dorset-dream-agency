    "version": "0.2.0",
    "configurations": [
        {
            "name": "App Dev",
            "port": 3000,
            "request": "launch",
            "runtimeExecutable": "npm",
            "runtimeArgs": [
                "run",
                "dev"
            ],
            "skipFiles": [
                "<node_internals>/**"
            ],
        },
        {
            "name": "App Build",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "npm",
            "runtimeArgs": [
                "run",
                "build"
            ],
            "skipFiles": [
                "<node_internals>/**"
            ],
        },
    ]
}